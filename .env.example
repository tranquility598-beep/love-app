# ============================================
# Love App - Environment Variables Template
# ============================================
# 
# ⚠️ ВАЖНО: НЕ КОММИТЬТЕ ФАЙЛ .env В GIT!
# Этот файл - только шаблон для настройки
#
# Инструкция:
# 1. Скопируйте этот файл как .env
# 2. Заполните все значения своими данными
# 3. Убедитесь что .env в .gitignore
# ============================================

# MongoDB Configuration
# Локально: mongodb://localhost:27017/love-app
# Production (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net/love-app
MONGODB_URI=mongodb://localhost:27017/love-app

# Создатель / админ-панель (сокет founder:*): email или список user id через запятую
# FOUNDER_EMAIL=you@example.com
# FOUNDER_IDS=69b26a1f2ab0c77d91a105d4

# JWT Secret (ОБЯЗАТЕЛЬНО СМЕНИТЕ!)
# Сгенерируйте случайную строку: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-CHANGE-THIS-TO-RANDOM-STRING

# Server Configuration
PORT=5555
MAX_FILE_SIZE=52428800
CLIENT_URL=http://localhost:3000

# CORS Allowed Origins (comma-separated)
# Добавьте свои домены через запятую
ALLOWED_ORIGINS=http://localhost:5555,http://127.0.0.1:5555

# Admin security. Generate both secrets independently.
ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_2FA_ENCRYPTION_KEY=replace-with-an-independent-random-32-byte-secret
ADMIN_ALLOW_NO_ORIGIN=false

# Local-only, one-time bootstrap for the protected developer before TOTP setup.
# Store SHA-256 of a high-entropy code, never the plaintext. Forbidden in production.
# ADMIN_BOOTSTRAP_CODE_HASH=

# Local loopback testing only. Returns the admin email OTP to the local login UI.
# The server refuses to start with this enabled in production.
ADMIN_LOCAL_EMAIL_PREVIEW=false

# Reversible rollout switches. Set a flag to false to disable that module.
FEATURE_ADMIN_V1=true
FEATURE_CASES_V1=true
FEATURE_COMMUNITY_V1=true
FEATURE_ANALYTICS_V1=true
FEATURE_STAFF_COMMS_V1=true

# TURN relay for authenticated staff voice rooms. Keep credentials server-side.
STAFF_TURN_URLS=turn:turn.example.com:3478,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
STAFF_TURN_USERNAME=replace-with-turn-username
STAFF_TURN_CREDENTIAL=replace-with-turn-credential

# User voice (WebRTC) TURN relay. Credentials are issued by GET /api/webrtc/ice-config
# and never stored in client code.
# TURN_URLS — список TURN-адресов через запятую.
# TURN_SECRET — shared secret coturn (static-auth-secret + use-auth-secret):
#   при заданном секрете сервер выдаёт временные HMAC-credentials (рекомендуется).
#   Сгенерируйте: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TURN_TTL — время жизни временных credentials в секундах (по умолчанию 86400).
# Переходный режим: если TURN_SECRET не задан, но заданы TURN_USERNAME/TURN_CREDENTIAL,
# сервер выдаёт статические credentials из env (секреты не покидают сервер).
TURN_URLS=turn:your-turn-server.example.com:3478,turn:your-turn-server.example.com:3478?transport=tcp
# TURN_SECRET=
# TURN_TTL=86400
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Bind address. В production за reverse proxy (Nginx) используйте 127.0.0.1,
# чтобы backend не был доступен напрямую из интернета в обход proxy.
# HOST=127.0.0.1

# Google OAuth Credentials (Development)
# Получите на: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:5555/api/auth/google/callback

# Google OAuth Credentials (Production)
# Для Render/Heroku добавьте production callback URL
PROD_GOOGLE_CALLBACK_URL=https://your-domain.onrender.com/api/auth/google/callback

# Email Configuration (SMTP)
# Для доменной почты используйте SMTP провайдера loveapp.chat.
MAIL_FROM=noreply@loveapp.chat
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@loveapp.chat
SMTP_PASS=your-smtp-password-here

# Optional Gmail fallback (если SMTP_HOST не задан)
GMAIL_USER=your-gmail@gmail.com
GMAIL_PASS=your-gmail-app-password-here

# Preferred production delivery over HTTPS. Keep the key only in server environment variables.
RESEND_API_KEY=re_your-server-side-key
# The sender domain must be verified in Resend.
# MAIL_FROM=Love <noreply@loveapp.chat>

# ============================================
# Production Deployment (Render/Heroku)
# ============================================
# 
# Для production НЕ используйте .env файл!
# Добавьте переменные через Dashboard:
#
# Render: Dashboard → Environment → Add Environment Variable
# Heroku: Settings → Config Vars → Reveal Config Vars
#
# Рекомендации для production:
# - Используйте разные JWT_SECRET для dev и prod
# - Используйте MongoDB Atlas вместо локальной БД
# - Создайте отдельные Google OAuth credentials для prod
# - Используйте HTTPS для всех callback URLs
# ============================================
