  "private": true,
  "description": "Love API and realtime backend",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test tests/*.test.js",
